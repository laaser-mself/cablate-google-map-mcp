# MCP Server Framework Configuration

# Main MCP Server Port
MCP_SERVER_PORT=3000

# Google Maps API Key (required for maps tools)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Max concurrent outbound Google Maps API requests (default: 50)
GOOGLE_MAPS_MAX_CONCURRENT=50

# MCP session management (HTTP multi-client)
# Max simultaneous MCP sessions (default: 500)
MCP_MAX_SESSIONS=500
# Close sessions idle longer than this, in milliseconds (default: 1800000 = 30 min)
MCP_SESSION_IDLE_MS=1800000
# How often to scan for idle sessions, in milliseconds (default: 60000 = 1 min)
MCP_SESSION_SWEEP_MS=60000

# Add your custom server ports here
# YOUR_CUSTOM_SERVER_PORT=3001